{
  "name": "afterlight",
  "private": true,
  "version": "0.10.0",
  "type": "module",
  "description": "A local-first personal ophthalmology record and visual diary.",
  "scripts": {
    "predev": "node scripts/sync-explorer.mjs",
    "dev": "vite",
    "prebuild": "node scripts/sync-explorer.mjs",
    "build": "tsc -b && vite build && node scripts/build-sw.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "guard": "node scripts/check-invariants.mjs",
    "verify": "tsc -b && npm run lint && npm run guard && npm run verify:assets && npm run changelog:check && npm run test && npm run build && npm run bundle && npm run nonetwork",
    "bundle": "node scripts/check-bundle.mjs",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "build:standalone": "node scripts/build-standalone.mjs",
    "verify:assets": "node scripts/verify-assets.mjs",
    "changelog": "node scripts/build-changelog.mjs",
    "changelog:check": "node scripts/build-changelog.mjs --check",
    "clinical-pack": "node scripts/clinical-pack.mjs",
    "nonetwork": "node scripts/check-no-network.mjs",
    "release": "node scripts/release.mjs",
    "build:site": "npm run build && node scripts/build-site.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.5.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^5.2.0",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
